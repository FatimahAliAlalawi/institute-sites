# منصة البصائر — توجيه كل الطلبات إلى مجلد public (مناسب للرفع مباشرة في public_html)
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# حماية إضافية للملفات الحساسة حتى لو تعطّل mod_rewrite
<FilesMatch "^(\.env.*|composer\.(json|lock)|artisan|package\.json|phpunit\.xml|vite\.config\.js|README\.md|INSTALL-AR\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
